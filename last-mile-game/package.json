{
  "name": "last-mile-game",
  "version": "1.0.0",
  "description": "",
  "main": "dev-checks.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "vendor": "bash tools/vendor.sh",
    "stage": "bash last-mile/stage_web.sh dist/stage && bash tools/check-stage.sh dist/stage",
    "check:cdn": "node tools/check-no-cdn.mjs --self-test && node tools/check-no-cdn.mjs dist/stage",
    "package": "bash last-mile/package_web_portal.sh",
    "check:size": "node tools/check-size.mjs dist/shiplyp-web-portal.zip",
    "smoke": "node tools/smoke.mjs dist/stage --out dist/smoke && node tools/smoke.mjs dist/stage --no-storage --out dist/smoke && node tools/smoke.mjs dist/stage --returning --out dist/smoke",
    "check:save": "node tools/check-save.cjs",
    "check:telemetry": "node tools/check-telemetry.cjs",
    "check:roadnet": "node tools/check-roadnet.mjs dist/stage",
    "check:traffic": "node tools/check-traffic.mjs dist/stage 15",
    "ci": "npm run check:save && npm run check:telemetry && npm run stage && npm run check:cdn && npm run package && npm run check:size && npm run smoke && npm run check:roadnet && npm run check:traffic",
    "loadtest": "node tools/load-test.mjs dist/stage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/bungee": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/russo-one": "5.3.0",
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "three": "0.128.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
